{
  "name": "dictee-magique",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/check-engine.mjs && vite build && node scripts/audit-dist.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "rom:check": "node scripts/check-rom.mjs",
    "start": "vite --host 127.0.0.1 --open",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "@types/node": "22.19.0"
  }
}
